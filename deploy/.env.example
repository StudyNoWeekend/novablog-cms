# ===== NovaBlog 容器部署环境变量（复制为 .env 后修改） =====

# 对外域名（nginx server_name；本地/IP 访问用 _）
NOVABLOG_DOMAIN=_
NOVABLOG_HTTP_PORT=80

# 管理后台独立入口（代托管场景：可与博客端口分开暴露/加白名单/单独出证书）
NOVABLOG_ADMIN_HTTP_PORT=8080
NOVABLOG_ADMIN_DOMAIN=_

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=novablog

# Redis
REDIS_PASSWORD=change-me-strong-password
