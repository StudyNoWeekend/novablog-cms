# ===== NovaBlog 部署环境变量（cp .env.example .env 后修改；或直接运行 ./deploy.sh 自动生成） =====

# ---- 镜像与版本号（不指定版本号时使用 latest） ----
NOVABLOG_IMAGE_REPO=ghcr.io/studynoweekend/novablog-cms
NOVABLOG_VERSION=latest
# 本地构建模式（--build）注入的二进制版本号（/health 与启动日志可见）
NOVABLOG_BUILD_VERSION=dev

# ---- 入口端口与域名 ----
# 博客入口（对外）
NOVABLOG_DOMAIN=_
NOVABLOG_HTTP_PORT=80
# 管理后台独立入口（代托管场景：可与博客端口分开暴露/加白名单/单独出证书）
NOVABLOG_ADMIN_DOMAIN=_
NOVABLOG_ADMIN_HTTP_PORT=8080
# 容器内后台监听端口与静态资源 base 路径（须与构建期 VITE_BASE_PATH 一致）
NOVABLOG_ADMIN_CONTAINER_PORT=8080
NOVABLOG_ADMIN_BASE=/admin/

# ---- 挂载目录（相对路径以 deploy/ 为基准，建议写绝对路径） ----
# config.yaml 所在文件夹（该文件夹下需有 config.yaml）
NOVABLOG_CONFIG_DIR=./config
NOVABLOG_UPLOADS_DIR=./data/uploads
NOVABLOG_THEMES_DIR=./data/themes
NOVABLOG_LOGS_DIR=./data/logs
# 自备博客前端目录（含 theme.json 与 dist/）；留空目录=使用后台安装的主题
NOVABLOG_BLOG_FRONTEND_DIR=./data/blog-frontend

# ---- 内置数据库（仅 docker-compose.local-pg.yml / docker-compose.local-redis.yml 使用） ----
NOVABLOG_PGDATA_DIR=./data/pg
NOVABLOG_REDISDATA_DIR=./data/redis
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=novablog
REDIS_PASSWORD=change-me-strong-password
